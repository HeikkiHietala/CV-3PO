[Unit]
Description=CV-3PO Citroen status fetcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=YOUR_USER
WorkingDirectory=%h/cv3po
EnvironmentFile=%h/cv3po/.env
ExecStart=%h/cv3po/venv/bin/python %h/cv3po/src/status_fetch.py

[Install]
WantedBy=multi-user.target
