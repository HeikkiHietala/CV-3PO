# CV-3PO configuration example
# Copy this file to .env and replace the example values.

# Sabulo status upload
STATUS_URL=https://example.com/e-c4/fetch_status.php
STATUS_KEY=replace_with_status_key

# Sabulo agent
AGENT_URL=https://example.com/e-c4/agent.php
AGENT_KEY=replace_with_agent_key

# Stellantis OAuth
OAUTH_CLIENT_ID=replace_with_oauth_client_id
OAUTH_CLIENT_SECRET=replace_with_oauth_client_secret

# Usually these defaults do not need changing
OAUTH_REALM=clientsB2CCitroen
LOCALE=fi-FI
OAUTH_TOKEN_URL=https://idpcvs.citroen.com/am/oauth2/access_token
