# CV-3PO configuration
# This file is copied to .env automatically by install.sh.

# Local vehicle status cache
STATUS_FILE=/var/lib/cv3po/status.json

# Optional external status upload
# STATUS_URL=https://your-server.example/status
# STATUS_KEY=replace_with_status_key

# Optional external agent
# AGENT_URL=https://your-server.example/agent
# AGENT_KEY=replace_with_agent_key

# Stellantis OAuth
# Usually these defaults do not need changing
OAUTH_REALM=clientsB2CCitroen
LOCALE=fi-FI
COUNTRY_CODE=FI
OAUTH_TOKEN_URL=https://idpcvs.citroen.com/am/oauth2/access_token
